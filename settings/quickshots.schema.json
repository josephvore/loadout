{
  "app": "quickshots",
  "title": "QuickShots — Screenshots",
  "format": "json",
  "target": "~/.hammerspoon/settings/quickshots.json",
  "postSave": ["/bin/zsh", "-lc", "hs -c 'hs.reload()'"],
  "fields": [
    {"key": "saveDir", "label": "Screenshot folder", "type": "folder", "default": "~/Pictures/QuickShots"},
    {"key": "pasteMode", "label": "Clipboard format", "type": "enum", "options": ["paths", "quoted", "markdown", "files", "images", "codex"], "default": "paths", "help": "What lands on the clipboard after a capture"},
    {"key": "pasteAfterCopy", "label": "Auto-paste after capture", "type": "bool", "default": "true"},
    {"key": "defaultLastN", "label": "Default last-N count", "type": "int", "default": "4"},
    {"key": "retentionDays", "label": "Delete shots after (days)", "type": "int", "default": "30", "help": "0 disables the retention sweep"}
  ]
}
