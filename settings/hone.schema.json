{
  "app": "hone",
  "title": "Refine (Hone) — AI Text",
  "format": "json",
  "target": "~/.hammerspoon/settings/hone.json",
  "postSave": ["/bin/zsh", "-lc", "hs -c 'hs.reload()'"],
  "fields": [
    {"key": "model", "label": "Refine model", "type": "string", "default": "gpt-5.4"},
    {"key": "autoRefineModel", "label": "Auto-refine model", "type": "string", "default": "gpt-5.4-nano"},
    {"key": "reasoningEffort", "label": "Reasoning effort", "type": "enum", "options": ["none", "low", "medium", "high", "xhigh"], "default": "none", "help": "none is fastest"},
    {"key": "restoreClipboard", "label": "Restore clipboard after paste", "type": "bool", "default": "false"}
  ]
}
