# Optional dependencies for Loadout. Install with:  brew bundle --file=Brewfile
# Nothing here is installed automatically — bootstrap.sh only checks and reports.

# --- Core app runtime ---
cask "hammerspoon"        # runtime for QuickShots, Murmur, Hone, Relay, Palette

# --- Murmur's dictation daemon needs the Swift toolchain ---
# Install the Xcode Command Line Tools separately: xcode-select --install

# --- Optional: Reap's dropdown UI + Relay's dictation deeplink ---
cask "raycast"

# --- Optional: tools the zsh config (shell/) uses ---
brew "fzf"      # fuzzy finder
brew "eza"      # modern ls
brew "zoxide"   # smarter cd
brew "fnm"      # fast node version manager
brew "pyenv"    # python version manager
brew "direnv"   # per-directory env
brew "bat"      # cat with syntax highlighting
brew "fd"       # fast find
brew "lua"      # to run the test suite locally
