.build/
.swiftpm/
dictation_proper_nouns.tsv
*.bak
*.backup-*
*.prelink-backup-*
.DS_Store

# --- Installer backups ---
.loadout-backup-*/

# --- Never commit secrets ---
*.pem
*.key
*_token
*_secret
.env
.env.*

# --- Local data & build output (never commit user data) ---
