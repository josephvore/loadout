# --- Build output & machine-local noise ---
.build/
.swiftpm/
dictation_proper_nouns.tsv
*.bak
*.backup-*
*.prelink-backup-*
.DS_Store

# --- Installer backups ---
.loadout-backup-*/

# --- Never commit secrets ---
*.pem
*.key
*_token
*_secret
.env
.env.*

# --- Local data & build output (never commit user data) ---
__pycache__/
apps/snag/captures/
apps/snag/state/
apps/snag/snag.local.conf
lib/settings/loadout-settings
settings/*.settings.json

# Private shell environments and local configuration (at any depth).
.zshenv
.zshrc.local
.zprofile.local
loadout.local.lua
.envrc

# Runtime logs and recordings.
logs/
*.log
*.wav
